{
  "name": "homestand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A season-planning agent for Minor League promotions directors: theme nights scored against what the ballpark's own market loves.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "study:fetch": "tsx study/fetch.ts",
    "study:build": "tsx study/build.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramenprotokol/homestand.git"
  },
  "homepage": "https://github.com/ramenprotokol/homestand",
  "dependencies": {
    "ml-matrix": "^6.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
