{
  "name": "homestand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A season-planning agent for Minor League promotions directors: theme nights scored against what the ballpark's own market loves.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "prepare:data": "node scripts/prepare-data.mjs",
    "typecheck": "node scripts/prepare-data.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "study:fetch": "tsx study/fetch.ts",
    "study:build": "tsx study/build.ts",
    "study:day1": "tsx study/day1.ts",
    "worker:dev": "node scripts/prepare-data.mjs && wrangler dev --local --env check --ip 127.0.0.1 --port 8788",
    "e2e": "playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "qloo:resolve": "node --env-file=.dev.vars --import tsx scripts/qloo-resolve.ts",
    "qloo:coverage": "node --env-file=.dev.vars --import tsx scripts/qloo-coverage.ts",
    "qloo:reference": "node --env-file=.dev.vars --import tsx scripts/qloo-reference.ts",
    "qloo:smoke": "node --env-file=.dev.vars --import tsx scripts/qloo-smoke.ts",
    "reference:synthetic": "tsx scripts/make-synthetic-reference.ts",
    "study:pull": "tsx study/pull.ts",
    "study:analyze": "tsx study/analyze.ts",
    "qloo:discovery-reference": "node --env-file=.dev.vars --import tsx scripts/qloo-discovery-reference.ts",
    "qloo:support-acts": "node --env-file=.dev.vars --import tsx scripts/qloo-support-acts.ts",
    "qloo:acts-reference": "node --env-file=.dev.vars --import tsx scripts/qloo-acts-reference.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramenprotokol/homestand.git"
  },
  "homepage": "https://github.com/ramenprotokol/homestand",
  "dependencies": {
    "gsap": "3.12.5",
    "ml-matrix": "^6.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.0"
  }
}
